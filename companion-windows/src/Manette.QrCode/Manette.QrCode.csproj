<Project Sdk="Microsoft.NET.Sdk">
  <!-- QR code encoding. ThirdParty/QrCodeGenerator is vendored, unmodified, from github.com/manuelbl/QrCodeGenerator
       (MIT, see its LICENSE.txt), itself based on Nayuki's QR Code generator. Vendored rather than a NuGet reference so
       the build needs no extra package. -->
  <PropertyGroup>
    <RootNamespace>Manette.QrCode</RootNamespace>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- The vendored library was written without nullable checking; our solution-wide setting only produced noise there. -->
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Manette.Core.Tests" />
  </ItemGroup>
</Project>
